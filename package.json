{
  "name": "shore-leave-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Shore Leave Management System - Biometric Gate Control & Cadet Portal",
  "scripts": {
    "dev": "npm run dev:backend",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend start",
    "build:frontend": "npm --prefix frontend run build",
    "check": "npm --prefix backend run check",
    "backup": "npm --prefix backend run backup",
    "host": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/keep-backend-up.ps1",
    "install:all": "npm install && npm --prefix frontend install && npm --prefix backend install",
    "install:frontend": "npm --prefix frontend install",
    "install:backend": "npm --prefix backend install",
    "install:python": "npm --prefix backend run install:python"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "mongodb": "^7.3.0",
    "nfc-pcsc": "^0.8.1"
  }
}
