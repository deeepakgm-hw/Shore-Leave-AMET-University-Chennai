{
  "name": "shore-leave-fixed-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Convenience npm scripts for the Shore Leave Management System.",
  "scripts": {
    "start": "npm --prefix shore-leave-fixed/backend start",
    "host": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/keep-backend-up.ps1",
    "host:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-shoreleave-autostart.ps1",
    "check": "npm --prefix shore-leave-fixed/backend run check",
    "backup": "npm --prefix shore-leave-fixed/backend run backup",
    "install:backend": "npm --prefix shore-leave-fixed/backend install",
    "install:python": "npm --prefix shore-leave-fixed/backend run install:python"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "mongodb": "^7.3.0",
    "nfc-pcsc": "^0.8.1"
  }
}
