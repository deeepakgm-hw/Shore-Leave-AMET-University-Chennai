PORT=3000
MONGODB_URI=mongodb+srv://your_database_user:your_url_encoded_password@your-cluster.mongodb.net/shoreleave?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
QR_SECRET=replace_with_a_long_random_qr_secret
OTP_ENCRYPTION_KEY=replace_with_a_long_random_otp_secret
SMTP_SERVICE=gmail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=your_email@gmail.com
VAPID_SUBJECT=mailto:admin@shoreleave.local
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
FACE_SERVICE_URL=http://127.0.0.1:5001
FACE_SERVICE_PORT=5001
FACE_SERVICE_TIMEOUT_MS=30000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_backend_service_role_key

# Optional backend-only integrations
OPENAI_API_KEY=
LOG_DIR=


NFC_DEVICE_NAME=Gate-1
NFC_DEVICE_ID=gate-1
NFC_DEVICE_LOCATION=Main Gate

# Mantra MFS110 fingerprint scanner (backend-only hardware bridge)
FINGERPRINT_ENCRYPTION_KEY=replace_with_at_least_32_random_characters
MANTRA_MFS110_BRIDGE_URL=http://127.0.0.1:11111
FINGERPRINT_BRIDGE_TOKEN=replace_with_a_private_bridge_token
FINGERPRINT_DEVICE_TYPE=MANTRA_MFS110
FINGERPRINT_DEVICE_LABEL=Mantra MFS110
FINGERPRINT_CAPTURE_TIMEOUT_MS=30000
FINGERPRINT_HEARTBEAT_MS=10000
FINGERPRINT_MATCH_THRESHOLD=
FINGERPRINT_IDENTIFICATION_LIMIT=500

NODE_ENV=production
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_DUTY_USERNAME=
DEFAULT_DUTY_PASSWORD=
SEED_SAMPLE_CADETS=false
BACKUP_RETAIN_DAYS=30
